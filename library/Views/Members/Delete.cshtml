
@model library.Models.Member

@{
    ViewData["Title"] = "Delete a member";
}

<h1>Delete a member</h1>

<h3>Are you sure you want to delete this member?</h3>

<div class="mb-3">
    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @(Model.Email ?? "—")</p>
    <p><strong>Member Type:</strong> @Model.MemberType</p>
</div>

<form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>


@model IEnumerable<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<h1>Members</h1>

<a asp-action="Create" class="btn btn-primary">Add a member</a>

<p>@Model.Count() members in the directory.</p>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Member Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.FullName</td>
                <td>@(member.Email ?? "—")</td>
                <td>@member.MemberType</td>
            </tr>
        }
    </tbody>
</table>

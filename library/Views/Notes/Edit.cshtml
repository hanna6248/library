@model library.Models.Note

@{
    ViewData["Title"] = "Edit Note";
}

<h1>Edit Note</h1>
<p class="text-muted">Update the details of this note.</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.NoteId" method="post">
            <input type="hidden" asp-for="NoteId" />
            <input type="hidden" asp-for="CreatedOn" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="form-control" maxlength="100" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label">Body (optional)</label>
                <textarea asp-for="Body" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@model IEnumerable<library.Models.Note>

@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Notes</h1>
        <p class="text-muted mb-0">@Model.Count() notes in the library</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a note</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Title</th>
            <th>Body</th>
            <th>Created On</th>
            <th class="text-end" style="width:12rem">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td class="text-end">@note.NoteId</td>
                <td>@note.Title</td>
                <td>@(note.Body ?? "—")</td>
                <td>@note.CreatedOn.ToString("yyyy-MM-dd")</td>
                <td class="text-end">
                    <a asp-action="Edit"
                       asp-route-id="@note.NoteId"
                       class="btn btn-sm btn-warning">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@note.NoteId"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
